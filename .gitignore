# ── Environment files — never commit. Use .env.example as a template. ──
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# ── Secrets: signed-in YouTube cookies for yt-dlp — NEVER commit. ──
# These grant access to your Google/YouTube account. The real file lives
# outside the repo (~/.config/clipcast/yt-cookies.txt); these patterns are a
# safety net for any cookies file that lands in-repo.
*cookies*.txt
yt-cookies.txt
**/yt-cookies.txt
*.cookies

# ── ClipCast frontend (Next.js / T3) ──────────────────────────
clipcast-frontend/node_modules/
clipcast-frontend/.next/
clipcast-frontend/out/
clipcast-frontend/dist/
clipcast-frontend/build/
clipcast-frontend/coverage/
clipcast-frontend/*.tsbuildinfo
clipcast-frontend/next-env.d.ts

# ── ClipCast backend (Python / Modal) ─────────────────────────
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
clipcast-backend/*.pyc
clipcast-backend/*.pyo
clipcast-backend/*.pyd
clipcast-backend/.venv/
clipcast-backend/venv/
clipcast-backend/env/

