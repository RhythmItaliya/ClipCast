# ── OS / editor ───────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace

# ── Logs / temp ───────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.swp
*.swo
*.swn

# ── Generated media / clips ───────────────────────────────────
*.mp4
clips_manifest.json

# ── Environment files — never commit. Use .env.example as a template. ──
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# ── ClipCast frontend (Next.js / T3) ──────────────────────────
clipcast-frontend/node_modules/
clipcast-frontend/.next/
clipcast-frontend/out/
clipcast-frontend/*.tsbuildinfo
clipcast-frontend/next-env.d.ts

# ── ClipCast backend (Python / Modal) ─────────────────────────
**/__pycache__/
clipcast-backend/*.pyc
clipcast-backend/*.pyo
clipcast-backend/*.pyd
clipcast-backend/.venv/
clipcast-backend/venv/
clipcast-backend/env/

# ── Local tooling binaries (downloaded Stripe CLI) ────────────
/stripe

