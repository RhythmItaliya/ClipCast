      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "text": "apps/processor/main.py — class ClipCast\n\nload_model()  @modal.enter — WhisperX + Gemini client, resident per container\ntranscribe_video()  — ffmpeg audio extract -> WhisperX word-level transcript\nidentify_moments()  — transcript + CLIP_MODE_PROMPTS -> Gemini -> [{start,end}]\nprocess_clip() / create_preview_clip()  — TalkNet ASD (asd/) -> 9:16 crop\n  (create_vertical_video) -> burned captions (create_subtitles_with_ffmpeg)\nprocess_video()  @modal.fastapi_endpoint — orchestrates all of the above",
      "fontSize": 13.5,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "apps/processor/main.py — class ClipCast\n\nload_model()  @modal.enter — WhisperX + Gemini client, resident per container\ntranscribe_video()  — ffmpeg audio extract -> WhisperX word-level transcript\nidentify_moments()  — transcript + CLIP_MODE_PROMPTS -> Gemini -> [{start,end}]\nprocess_clip() / create_preview_clip()  — TalkNet ASD (asd/) -> 9:16 crop\n  (create_vertical_video) -> burned captions (create_subtitles_with_ffmpeg)\nprocess_video()  @modal.fastapi_endpoint — orchestrates all of the above",
      "lineHeight": 1.25,
      "autoResize": true
    },
