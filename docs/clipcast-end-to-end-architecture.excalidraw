      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "text": "apps/processor/main.py — class ClipCast\n\nload_model()  @modal.enter — WhisperX + Gemini client, resident per container\ntranscribe_video()  — ffmpeg audio extract -> WhisperX word-level transcript\nidentify_moments()  — transcript + CLIP_MODE_PROMPTS -> Gemini -> [{start,end,title}]\nprocess_clip() / create_preview_clip()  — TalkNet ASD (asd/) -> 9:16 crop ->\n  karaoke captions (brand-indigo word highlight, no black box) -> subtle\n  watermark -> create_thumbnail() -> returns {s3_key,thumbnail_s3_key,title,duration}",
      "fontSize": 13.5,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "apps/processor/main.py — class ClipCast\n\nload_model()  @modal.enter — WhisperX + Gemini client, resident per container\ntranscribe_video()  — ffmpeg audio extract -> WhisperX word-level transcript\nidentify_moments()  — transcript + CLIP_MODE_PROMPTS -> Gemini -> [{start,end,title}]\nprocess_clip() / create_preview_clip()  — TalkNet ASD (asd/) -> 9:16 crop ->\n  karaoke captions (brand-indigo word highlight, no black box) -> subtle\n  watermark -> create_thumbnail() -> returns {s3_key,thumbnail_s3_key,title,duration}",
      "lineHeight": 1.25,
      "autoResize": true
    },
