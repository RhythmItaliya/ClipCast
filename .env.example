# ClipCast — example environment file
#
# Copy this file to `.env` (in this same project root) and fill in real values.
# The `.env` file is gitignored.
#
# This is the single source of environment variables for the whole project:
#   • The Next.js frontend loads it via `@next/env` from
#     clipcast-frontend/next.config.js (loadEnvConfig('..')).
#   • The Modal Python backend reads these values from a Modal Secret, created
#     from this file by clipcast-backend/scripts/setup_modal_secret.py.
#
# When you add a new variable here, also update
# clipcast-frontend/src/env.js so the runtime validation knows about it.

# --- Node env ---------------------------------------------------------------
NODE_ENV=development

# --- NextAuth ---------------------------------------------------------------
# Generate a fresh secret with: npx auth secret
AUTH_SECRET=""

# --- Discord OAuth ----------------------------------------------------------
# Create an app at https://discord.com/developers/applications
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# --- Database (Supabase Postgres) -------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=""
# Schema migrations — session pooler (supports DDL)
DIRECT_URL=""

# --- AWS S3 (video storage) -------------------------------------------------
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
S3_BUCKET_NAME=""

# --- Modal backend (video processing endpoint) -----------------------------
# Public Modal endpoint URL emitted when you deploy the backend.
PROCESS_VIDEO_ENDPOINT=""
# CPU-only Modal endpoint that downloads YouTube through YT_DLP_PROXY and
# uploads the untouched high-quality source directly to S3.
DOWNLOAD_VIDEO_ENDPOINT=""
# Shared bearer token used by the frontend to authenticate to Modal.
PROCESS_VIDEO_ENDPOINT_AUTH=""

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_SMALL_CREDIT_PACK=""
STRIPE_MEDIUM_CREDIT_PACK=""
STRIPE_LARGE_CREDIT_PACK=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Gemini AI (consumed by the Modal backend) -----------------------------
GEMINI_API_KEY=""

# --- Google OAuth (YouTube channel connect) ----------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Add redirect URI: {BASE_URL}/api/youtube/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- App ---------------------------------------------------------------------
BASE_URL="http://localhost:3000"

# --- Inngest -----------------------------------------------------------------
# Event Key: used to send events (found in Cloud dashboard or generated locally)
# Signing Key: used to secure the /api/inngest webhook
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- YouTube-URL download path (OPTIONAL) ------------------------------------
# The primary input is direct file upload (no proxy needed). The YouTube-URL
# path only works if you route Modal's download through a RESIDENTIAL proxy,
# because YouTube blocks datacenter IPs. Use a paid residential proxy service
# (IPRoyal, Bright Data, SmartProxy, etc.). Leave empty for upload-only.
# Example: "http://user:pass@proxy.example.com:22225"
YT_DLP_PROXY=""

# --- SMTP (Email) ------------------------------------------------------------
SMTP_HOST=""
SMTP_USER=""
SMTP_PASSWORD=""